{
  "_meta": {
    "what": "ทะเบียนผู้ใช้/ไลน์จริงของโรงงาน แบบไม่มีชื่อคน (acct = md5(uid) 8 ตัวแรก) — ให้ด่าน scopeRegistryGate เล่นกฎขอบเขตซ้ำกับของจริง",
    "why": "25/10 แก้กฎขอบเขตแล้ว build/เทส/crashsweep ผ่านหมด แต่หัวหน้ากลุ่ม PD1 3 คนเหลือไลน์เดียว = เปิดกะไม่ได้เช้าวันจันทร์ 26/10",
    "snapshot_date": "2026-10-26",
    "projects": {
      "profiles+production_lines": "Main (MAIN · ewhdfqwfwofivojtsizn)",
      "opened_lines": "DR (Product DB · eyhclzkifitbhbljgoav)"
    },
    "refresh_sql": {
      "1_main_profiles": "select json_agg(json_build_object('acct',left(md5(id::text),8),'role',role,'scope_depth',scope_depth,'sections',sections,'section',section,'line_id',line_id) order by role) from profiles",
      "2_main_lines": "select json_agg(json_build_object('id',id,'name',name,'parent_line_name',parent_line_name,'section',section,'unit_kind',unit_kind,'is_active',is_active) order by id) from production_lines",
      "3_dr_opened": "with t as (select left(md5(lower(trim(opened_by_uid))),8) acct, line_name from production_sessions where opened_by_uid is not null and opened_by_uid <> '' and status <> 'void' and work_date >= (current_date - 90) group by 1,2) select json_agg(json_build_object('acct',acct,'lines',lines) order by acct) from (select acct, json_agg(line_name order by line_name) lines from t group by acct) x"
    },
    "note": "🔴 ห้ามใส่ชื่อคน/อีเมล/uid ดิบในไฟล์นี้ — acct เป็น md5 ที่ย้อนกลับไม่ได้ในทางปฏิบัติ · ชื่อไลน์/ส่วนงานไม่ใช่ข้อมูลส่วนบุคคล และกฎขอบเขตตัดสินด้วยค่าพวกนี้ จึงต้องเป็นค่าจริง",
    "moved_lines": {
      "f9cbcb2b": [
        "LINE ASSY TSRA",
        "LINE MAIN TSRA-1"
      ]
    },
    "moved_lines_note": "ไลน์ที่ถูกลบ/เปลี่ยนชื่อออกจากทะเบียนไปแล้ว — ด่าน 'งานจริงห้ามหาย' ข้ามให้ (เทียบกับทะเบียนปัจจุบันไม่ได้)"
  },
