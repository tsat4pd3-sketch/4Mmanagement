# ═══════════════════════════════════════════════════
# ESM — Enterprise Shopfloor Management
# Copy this file to .env and fill in your values
# See docs/SETUP_GUIDE.md for step-by-step instructions
# ═══════════════════════════════════════════════════

# Main Supabase Project (Auth, employees, 4M, shifts, skills)
VITE_SUPABASE_URL=https://YOUR_MAIN_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_main_anon_key_here

# Daily Report Supabase Project (production sessions, OEE, kanban)
# If using a single Supabase project, set these to the same values as above
VITE_SUPABASE_DR_URL=https://YOUR_DR_PROJECT.supabase.co
VITE_SUPABASE_DR_KEY=your_dr_anon_key_here
