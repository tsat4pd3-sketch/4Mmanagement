# ═══════════════════════════════════════════════════
# ESM — Enterprise Shopfloor Management
# Copy this file to .env and fill in your values
# See docs/SETUP_GUIDE.md for step-by-step instructions
#
# ⚠️ ทั้ง 4 ค่าต้องตั้งให้ครบทุกที่ที่ build (dev เครื่องตัวเอง / Render / server บริษัท)
#    ค่าเหล่านี้มีเจ้าของจุดเดียวในโค้ดคือ src/utils/appConfig.js
#    ขาดฝั่ง DR = แอปยัง fallback ไปฐานเดิมที่ฝังในโค้ด แล้วขึ้นป้ายเตือนแดงให้ admin เห็น
#    (ดูแผนย้ายมา server บริษัท: docs/SELF-HOST-MIGRATION.md)
# ═══════════════════════════════════════════════════

# Main Supabase Project (Auth, employees, 4M, shifts, skills, edge functions ทั้งหมด)
VITE_SUPABASE_URL=https://YOUR_MAIN_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_main_anon_key_here

# Daily Report Supabase Project (production sessions, OEE, kanban, PM, MTN)
# If using a single Supabase project, set these to the same values as above
VITE_SUPABASE_DR_URL=https://YOUR_DR_PROJECT.supabase.co
VITE_SUPABASE_DR_KEY=your_dr_anon_key_here
